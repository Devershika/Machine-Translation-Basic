##### Part A: Setting Up Machine Translation Model
from transformers import pipeline
# Load pre-trained translation model (English → French as example)
translator = pipeline("translation_en_to_fr", model="Helsinki-NLP/opus-mt-en-fr")

# Function to translate a sentence
def translate_sentence(sentence):
    result = translator(sentence, max_length=40)
    translated_text = result[0]['translation_text']
    print(f"Original: {sentence}")
    print(f"Translated: {translated_text}\n")
    return translated_text

# Test the function with at least five sentences
sentences = [
    "Hello, how are you?",
    "I am studying artificial intelligence.",
    "What is your name?",
    "This project is very interesting.",
    "We are learning machine translation using Hugging Face."
]

for s in sentences:
    translate_sentence(s)

##### Part B: Custom Dataset Translation
import pandas as pd

# Load translation model (English → French example)
translator = pipeline("translation_en_to_fr", model="Helsinki-NLP/opus-mt-en-fr")

#Create a small dataset (10 English sentences)
source_sentences = [
    "Good morning, have a nice day!",
    "I am learning machine learning.",
    "The weather is beautiful today.",
    "Can you help me with this problem?",
    "Artificial Intelligence is the future.",
    "I enjoy reading books in my free time.",
    "This food tastes delicious.",
    "Where is the nearest railway station?",
    "We are preparing for the final exams.",
    "Thank you very much for your support."
]

#  Translate sentences
translated_sentences = []
for sentence in source_sentences:
    result = translator(sentence, max_length=50)
    translated_text = result[0]['translation_text']
    translated_sentences.append(translated_text)

#  Save results in CSV
df = pd.DataFrame({
    "Source Sentence": source_sentences,
    "Translated Sentence": translated_sentences
})

# Save to file
df.to_csv("translations.csv", index=False)

print("Translations saved to 'translations.csv'")
print(df)

##### Part C: Model Performance Evaluation
from nltk.translate.bleu_score import sentence_bleu, corpus_bleu

reference_translations = [
    ["Bonjour, passe une bonne journée !"],
    ["J'apprends l'apprentissage automatique."],
    ["Le temps est magnifique aujourd'hui."],
    ["Peux-tu m'aider avec ce problème ?"],
    ["L'intelligence artificielle est l'avenir."],
    ["J'aime lire des livres pendant mon temps libre."],
    ["Cette nourriture est délicieuse."],
    ["Où est la gare la plus proche ?"],
    ["Nous nous préparons pour les examens finaux."],
    ["Merci beaucoup pour ton soutien."]
]

# Model translations (from Part B)
model_translations = translated_sentences

# Tokenize for BLEU
references = [[ref[0].split()] for ref in reference_translations]  # list of lists of tokens
candidates = [mt.split() for mt in model_translations]

# Compute BLEU score
corpus_score = corpus_bleu(references, candidates)

# Print results
print("BLEU Score:", corpus_score)
for i, (ref, cand) in enumerate(zip(reference_translations, model_translations)):
    sentence_score = sentence_bleu([ref[0].split()], cand.split())
    print(f"Sentence {i+1} BLEU: {sentence_score:.4f}")
